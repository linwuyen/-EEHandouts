  "verificationWorkflow": "name: Verify EEHandouts\n\non:\n  push:\n    branches:\n      - main\n      - 'fix/**'\n  pull_request:\n    branches: [main]\n  workflow_dispatch:\n\npermissions:\n  contents: read\n\njobs:\n  browser-regression:\n    runs-on: ubuntu-24.04\n    timeout-minutes: 15\n    steps:\n      - name: Checkout\n        uses: actions/checkout@v7\n      - name: Set up Node\n        uses: actions/setup-node@v7\n        with:\n          node-version: '22'\n          cache: 'npm'\n      - name: Install pinned browser test dependencies\n        run: |\n          npm ci --ignore-scripts --no-audit --no-fund\n          # The hosted Noble runner uses a mirror list for its signed Ubuntu packages.\n          if [[ -f /etc/apt/apt-mirrors.txt ]] && ! getent ahostsv4 azure.archive.ubuntu.com >/dev/null; then\n            for mirror in https://mirrors.edge.kernel.org/ubuntu https://mirror.math.princeton.edu/pub/ubuntu; do\n              if curl -fsSL --max-time 10 -o /dev/null \"$mirror/dists/noble/InRelease\"; then\n                printf '%s\\n' \"$mirror/\" | sudo tee /etc/apt/apt-mirrors.txt >/dev/null\n                echo \"Using $mirror for Ubuntu packages\"\n                break\n              fi\n            done\n          fi\n          npx playwright install --with-deps chromium\n      - name: Prepare SHA-512-verified local PDF.js assets\n        run: bash scripts/prepare-pdfjs.sh\n      - name: Run static site locally\n        run: |\n          python3 -m http.server 4173 --bind 127.0.0.1 > /tmp/eehandouts-server.log 2>&1 &\n          for i in $(seq 1 20); do\n            if curl -fsS http://127.0.0.1:4173/index.html > /dev/null; then exit 0; fi\n            sleep 1\n          done\n          cat /tmp/eehandouts-server.log\n          exit 1\n      - name: Browser and engineering regression\n        run: npm test\n      - name: Upload browser screenshots\n        if: always()\n        uses: actions/upload-artifact@v7\n        with:\n          name: eehandouts-review-screenshots\n          path: tests/screenshots/\n          if-no-files-found: ignore\n          retention-days: 7",
  "workingTree": "",
  "finishedAt": "2026-11-12T16:16:01.299Z"
